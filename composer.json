{
  "name": "directsaz/sdk",
  "description": "Directsaz Developer API SDK for PHP (Laravel, Symfony, plain PHP)",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "ext-hash": "*",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.0 || ^2.0"
  },
  "require-dev": {
    "guzzlehttp/guzzle": "^7.8"
  },
  "suggest": {
    "guzzlehttp/guzzle": "HTTP client used by Client::createDefault()",
    "illuminate/support": "For Laravel helpers"
  },
  "autoload": {
    "psr-4": {
      "Directsaz\\Sdk\\": "src/"
    }
  },
  "minimum-stability": "stable"
}
